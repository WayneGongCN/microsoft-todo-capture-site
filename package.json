{
  "name": "microsoft-todo-capture-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The independent, bilingual homepage for To Do Capture.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run build && npm test && npm run test:browser",
    "store:assets": "node scripts/generate-store-assets.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.65.0"
  }
}
